#!/bin/sh
# Run a card-kit tool on the repo you are in, in the image from the kit's Dockerfile.
# From the root of a cards repo, with card-kit cloned beside it:
#   ../card-kit/run check-cards
#   ../card-kit/run card-image website
# The image is built on first use and rebuilt when the Dockerfile changes.
# Docker is the only requirement.

set -eu

kit=$(cd "$(dirname "$0")" && pwd)
repo=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

if [ $# -eq 0 ]; then
  echo "usage: <path to card-kit>/run <tool> [args...]" >&2
  echo "tools: $(cd "$kit" && ls *.py | sed 's/\.py$//' | grep -vE '^(upstream|check-env|test-card|test-cards|backup-card|restore-card|verify-card|scan-card|check-app)$' | tr '\n' ' ')" >&2
  exit 2
fi

tool=$1
shift

if [ "$tool" = check-env ] || [ "$tool" = test-card ] || [ "$tool" = test-cards ] || [ "$tool" = backup-card ] || [ "$tool" = restore-card ] || [ "$tool" = verify-card ] || [ "$tool" = scan-card ] || [ "$tool" = check-app ]; then
  echo "$tool works on the machine a card runs on, so it runs outside a container:" >&2
  echo "  python3 $kit/$tool.py $*" >&2
  exit 2
fi

if [ ! -f "$kit/$tool.py" ]; then
  echo "no tool $tool.py in $kit" >&2
  exit 2
fi

# The tag follows the Dockerfile, so an edit to it builds a new image.
tag="edgible-card-kit:$(cksum < "$kit/Dockerfile" | cut -d ' ' -f 1)"
if ! docker image inspect "$tag" > /dev/null 2>&1; then
  echo "building $tag (first use)" >&2
  # A build that hung on cards-hub (2026-11-04) left its pip-install step's container running
  # for 28 hours, and the disk filled. --force-rm removes a build step's container even when
  # the build fails or is stopped, and the build gives up after 10 minutes where `timeout`
  # exists (Linux; on a Mac, coreutils' gtimeout).
  limit=""
  if command -v timeout > /dev/null 2>&1; then limit="timeout 600"
  elif command -v gtimeout > /dev/null 2>&1; then limit="gtimeout 600"
  fi
  if ! $limit docker build --quiet --force-rm --tag "$tag" - < "$kit/Dockerfile" > /dev/null; then
    echo "building $tag failed or took over 10 minutes: check the network, then run this again" >&2
    exit 1
  fi
fi

# Run from the same directory under the repo, so relative paths still work.
case "$PWD/" in
  "$repo"/*) here=${PWD#"$repo"} ;;
  *) here="" ;;
esac

# The repo and the kit are mounted separately; the tool runs as the calling user,
# so files it writes are not owned by root on Linux.
exec docker run --rm \
  --user "$(id -u):$(id -g)" \
  --env HOME=/tmp \
  --env GITHUB_TOKEN \
  --volume "$repo:/repo" \
  --volume "$kit:/kit:ro" \
  --workdir "/repo$here" \
  "$tag" python "/kit/$tool.py" "$@"
